<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.atguigu.myBatisPlus.mapper.UserMapper">
  <select id="selectMapById" resultType="map">
    select id, username, password, created_at from user where id = #{id}
  </select>

<!--  Page<User> selectPageByAge(@Param("page") Page<User> page, @Param("age") Integer age);-->
  <select id="selectPageByAge" resultType="User">
    select id, username, password, created_at from user where password = #{age}
  </select>

</mapper>